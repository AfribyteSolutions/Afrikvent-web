{
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string",
      "format": "email"
    },
    "event_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mobile_money",
        "stripe",
        "free"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "provider": {
      "type": "string"
    },
    "provider_transaction_id": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "mobile_money_provider": {
      "type": "string"
    },
    "mobile_number": {
      "type": "string"
    },
    "provider_response": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "legacy_supabase_id": {
      "type": "string"
    }
  },
  "required": [
    "buyer_id",
    "amount",
    "payment_method"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Payment"
}