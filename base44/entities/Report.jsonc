{
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "comment",
        "organizer",
        "user"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_id",
    "target_type",
    "target_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Report"
}