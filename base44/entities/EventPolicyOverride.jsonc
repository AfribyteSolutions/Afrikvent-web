{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "fee",
        "payout",
        "refund",
        "cancellation"
      ]
    },
    "requested_config": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_admin_approval",
        "approved",
        "rejected",
        "revoked"
      ],
      "default": "draft"
    },
    "reviewed_by": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "organizer_id",
    "policy_type"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "EventPolicyOverride"
}