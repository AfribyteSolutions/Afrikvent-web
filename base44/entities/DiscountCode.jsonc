{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number",
      "minimum": 0
    },
    "max_uses": {
      "type": "integer",
      "minimum": 0
    },
    "uses_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "legacy_supabase_id": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "organizer_id",
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "DiscountCode"
}