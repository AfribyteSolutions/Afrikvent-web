{
  "type": "object",
  "properties": {
    "maintenance_mode": {
      "type": "boolean",
      "default": false
    },
    "paid_payments_enabled": {
      "type": "boolean",
      "default": false
    },
    "free_checkout_enabled": {
      "type": "boolean",
      "default": true
    },
    "support_email": {
      "type": "string",
      "format": "email"
    },
    "default_country": {
      "type": "string",
      "default": "CM"
    },
    "default_currency": {
      "type": "string",
      "default": "XAF"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "PlatformSettings"
}