{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "event_status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "cancelled",
        "completed"
      ],
      "default": "draft"
    },
    "location_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "organizer_id": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_sponsored": {
      "type": "boolean",
      "default": false
    },
    "sponsor_name": {
      "type": "string"
    },
    "sponsor_logo_url": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "currency_symbol": {
      "type": "string",
      "default": "FCFA"
    },
    "category_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "sales_start_at": {
      "type": "string",
      "format": "date-time"
    },
    "sales_end_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellation_policy_id": {
      "type": "string"
    },
    "cancellation_policy_snapshot": {
      "type": "object"
    },
    "cancellation_policy_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "refund_policy_id": {
      "type": "string"
    },
    "refund_policy_snapshot": {
      "type": "object"
    },
    "refund_policy_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "legacy_supabase_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "organizer_id"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.event_status": "published"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "Event"
}