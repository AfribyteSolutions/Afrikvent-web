{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_started"
    },
    "rejection_reason": {
      "type": "string"
    },
    "passport_photo_uri": {
      "type": "string"
    },
    "id_front_photo_uri": {
      "type": "string"
    },
    "id_back_photo_uri": {
      "type": "string"
    },
    "selfie_with_id_uri": {
      "type": "string"
    },
    "social_links": {
      "type": "object"
    },
    "legacy_supabase_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "OrganizerProfile"
}