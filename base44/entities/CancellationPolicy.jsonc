{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "template_code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_cancellation_refund_mode": {
      "type": "string",
      "enum": [
        "full",
        "ticket_price_only",
        "credit",
        "manual"
      ],
      "default": "manual"
    },
    "postponement_mode": {
      "type": "string",
      "enum": [
        "tickets_remain_valid",
        "offer_refund",
        "offer_credit",
        "manual"
      ],
      "default": "manual"
    },
    "postponement_refund_window_hours": {
      "type": "integer",
      "minimum": 0
    },
    "organizer_liability": {
      "type": "boolean",
      "default": true
    },
    "buyer_disclosure": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "name",
    "template_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "CancellationPolicy"
}