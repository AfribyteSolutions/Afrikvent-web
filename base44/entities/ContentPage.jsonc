{
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "page_type": {
      "type": "string",
      "enum": [
        "help",
        "contact",
        "privacy",
        "terms",
        "about",
        "other"
      ],
      "default": "other"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.is_published": true
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "ContentPage"
}