{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform",
        "organizer",
        "event"
      ],
      "default": "platform"
    },
    "organizer_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "refunds_allowed": {
      "type": "boolean",
      "default": false
    },
    "cutoff_hours_before_event": {
      "type": "integer",
      "minimum": 0
    },
    "organizer_can_override": {
      "type": "boolean",
      "default": false
    },
    "buyer_fee_refundable": {
      "type": "boolean",
      "default": false
    },
    "processor_fee_refundable": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RefundPolicy"
}