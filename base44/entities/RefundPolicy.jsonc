{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "template_code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform"
      ],
      "default": "platform"
    },
    "refunds_allowed": {
      "type": "boolean",
      "default": false
    },
    "voluntary_cancellation_mode": {
      "type": "string",
      "enum": [
        "no_refund",
        "full_refund",
        "partial_refund"
      ],
      "default": "no_refund"
    },
    "cutoff_hours_before_event": {
      "type": "integer",
      "minimum": 0
    },
    "refund_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 100
    },
    "buyer_fee_refundable": {
      "type": "boolean",
      "default": false
    },
    "processor_fee_refundable": {
      "type": "boolean",
      "default": false
    },
    "buyer_disclosure": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "name",
    "template_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RefundPolicy"
}