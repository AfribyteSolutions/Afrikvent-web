{
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "processing",
        "completed",
        "failed"
      ],
      "default": "requested"
    },
    "provider_refund_id": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "order_id",
    "payment_id",
    "buyer_id",
    "organizer_id",
    "amount"
  ],
  "rls": {
    "create": {
      "data.buyer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RefundRequest"
}