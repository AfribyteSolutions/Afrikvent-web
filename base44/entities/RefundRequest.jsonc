{
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "voluntary",
        "event_cancelled",
        "event_postponed",
        "duplicate_payment",
        "fraud",
        "legal_or_provider",
        "admin_exception"
      ],
      "default": "voluntary"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "eligibility": {
      "type": "string",
      "enum": [
        "pending",
        "eligible",
        "ineligible",
        "manual_review"
      ],
      "default": "pending"
    },
    "eligibility_reason": {
      "type": "string"
    },
    "liability_party": {
      "type": "string",
      "enum": [
        "organizer",
        "platform",
        "processor",
        "shared",
        "unassigned"
      ],
      "default": "unassigned"
    },
    "policy_snapshot": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "processing",
        "completed",
        "failed"
      ],
      "default": "requested"
    },
    "provider_refund_id": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "payment_id",
    "buyer_id",
    "organizer_id",
    "amount"
  ],
  "rls": {
    "create": {
      "data.buyer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RefundRequest"
}