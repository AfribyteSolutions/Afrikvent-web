{
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "fapshi",
        "stripe"
      ]
    },
    "market": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false
    },
    "accept_payments": {
      "type": "boolean",
      "default": false
    },
    "allow_refunds": {
      "type": "boolean",
      "default": false
    },
    "allow_payouts": {
      "type": "boolean",
      "default": false
    },
    "config_status": {
      "type": "string",
      "enum": [
        "not_configured",
        "configured",
        "verified",
        "disabled"
      ],
      "default": "not_configured"
    },
    "public_label": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "PaymentProviderConfig"
}