{
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "available_amount": {
      "type": "number",
      "default": 0
    },
    "pending_amount": {
      "type": "number",
      "default": 0
    },
    "held_amount": {
      "type": "number",
      "default": 0
    },
    "lifetime_gross": {
      "type": "number",
      "default": 0
    },
    "lifetime_refunds": {
      "type": "number",
      "default": 0
    },
    "lifetime_fees": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organizer_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "OrganizerBalance"
}