{
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "device_reference": {
      "type": "string"
    },
    "device_label": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "manifest_version": {
      "type": "string"
    },
    "manifest_downloaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizer_id",
    "event_id",
    "user_id",
    "device_reference"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "CheckInDevice"
}