{
  "type": "object",
  "properties": {
    "subject_type": {
      "type": "string",
      "enum": [
        "organizer",
        "buyer",
        "event",
        "order",
        "payment"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "risk_type": {
      "type": "string",
      "enum": [
        "refund_spike",
        "dispute_spike",
        "negative_balance",
        "suspicious_sales",
        "identity",
        "manual",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "reason": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "subject_type",
    "subject_id",
    "risk_type",
    "severity"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RiskFlag"
}