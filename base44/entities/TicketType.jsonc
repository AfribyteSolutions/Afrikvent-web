{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "max_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "sold_quantity": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "ticket_image_url": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "XAF"
    },
    "currency_symbol": {
      "type": "string",
      "default": "FCFA"
    },
    "format": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "legacy_supabase_id": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "organizer_id",
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "TicketType"
}